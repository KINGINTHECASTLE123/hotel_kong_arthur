LOAD DATA LOCAL INFILE '/Users/eliasgarcia/Downloads/international_names_with_rooms_1000.csv'
INTO TABLE staging_international_1000
FIELDS TERMINATED BY ',' ENCLOSED BY '"'
LINES TERMINATED BY '\n'
IGNORE 1 LINES
(first_name, family_name, country, room_type, @days_rented, season, @price)
SET
  days_rented = NULLIF(@days_rented,''),
  price       = NULLIF(@price,'');

-- ROOM: indsæt nye room types
INSERT INTO Room (room_type)
SELECT DISTINCT s.room_type
FROM staging_international_1000 s
LEFT JOIN Room r ON r.room_type = s.room_type
WHERE s.room_type IS NOT NULL AND s.room_type <> ''
  AND r.room_id IS NULL;

-- indsættelse af gæster med opdigtet email
INSERT INTO Guest (full_name, country, email)
SELECT
  CONCAT_WS(' ', s.first_name, s.family_name)                            AS full_name,
  s.country,
  CONCAT(
    LOWER(REPLACE(s.first_name, ' ', '')), '.', LOWER(REPLACE(s.family_name, ' ', '')),
    '@example.com'
  ) AS email
FROM staging_international_1000 s
LEFT JOIN Guest g
  ON g.full_name = CONCAT_WS(' ', s.first_name, s.family_name)
 AND g.country   = s.country
WHERE g.guest_id IS NULL
  AND s.first_name IS NOT NULL AND s.first_name <> ''
  AND s.family_name IS NOT NULL AND s.family_name <> '';

-- BOOKING: map via navn+land → guest_id og room_type → room_id
INSERT INTO Booking (guest_id, room_id, season, days_rented, total_price)
SELECT
  g.guest_id,
  r.room_id,
  s.season,
  s.days_rented,
  s.price
FROM staging_international_1000 s
JOIN Guest g
  ON g.full_name = CONCAT_WS(' ', s.first_name, s.family_name)
 AND g.country   = s.country
JOIN Room r
  ON r.room_type = s.room_type
WHERE s.days_rented IS NOT NULL
  AND s.price IS NOT NULL;

SELECT COUNT(*) AS guests   FROM Guest;
SELECT COUNT(*) AS rooms    FROM Room;
SELECT COUNT(*) AS bookings FROM Booking;

