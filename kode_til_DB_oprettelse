USE hotel_kong_arthur2;


DROP TABLE IF EXISTS Guest;
CREATE TABLE Guest (
    guest_id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    country VARCHAR(100),
    email VARCHAR(100)
);


DROP TABLE IF EXISTS Room;
CREATE TABLE Room (
    room_id INT AUTO_INCREMENT PRIMARY KEY,
    room_type VARCHAR(100) NOT NULL,
    price_low INT,
    price_mid INT,
    price_high INT
);


DROP TABLE IF EXISTS Booking;
CREATE TABLE Booking (
    booking_id INT AUTO_INCREMENT PRIMARY KEY,
    guest_id INT,
    room_id INT,
    season VARCHAR(50),
    days_rented INT,
    total_price INT,
    FOREIGN KEY (guest_id) REFERENCES Guest(guest_id),
    FOREIGN KEY (room_id) REFERENCES Room(room_id)
);


DROP TABLE IF EXISTS DrinkSale;
CREATE TABLE DrinkSale (
    sale_id INT AUTO_INCREMENT PRIMARY KEY,
    drink_name VARCHAR(100) NOT NULL,
    category VARCHAR(100),
    price INT,
    units_sold INT,
    total_sale INT
);

-- eventuelle views til endpoints:

USE hotel_kong_arthur2;

-- BOOKING_OVERVIEW: én række pr. booking med navne & rumtype:

CREATE OR REPLACE VIEW v_booking_overview AS
SELECT
  b.booking_id,
  g.guest_id,
  g.full_name,
  g.country,
  r.room_id,
  r.room_type,
  b.season,
  b.days_rented,
  b.total_price,
  CASE WHEN b.days_rented > 0 THEN ROUND(b.total_price / b.days_rented, 2)
       ELSE NULL END AS avg_price_per_day
FROM Booking b
JOIN Guest   g ON g.guest_id = b.guest_id
JOIN Room    r ON r.room_id  = b.room_id;

-- REVENUE BY ROOM TYPE (til KPI + søjlediagram i Streamlit): 

CREATE OR REPLACE VIEW v_revenue_by_room_type AS
SELECT
  r.room_type,
  COUNT(*)                          AS bookings,
  SUM(b.days_rented)                AS total_days,
  SUM(b.total_price)                AS room_revenue,
  ROUND(SUM(b.total_price) / NULLIF(SUM(b.days_rented),0), 2) AS avg_price_per_day
FROM Booking b
JOIN Room r ON r.room_id = b.room_id
GROUP BY r.room_type;

-- REVENUE BY COUNTRY (KPI pr. land)
CREATE OR REPLACE VIEW v_revenue_by_country AS
SELECT
  g.country,
  COUNT(*)           AS bookings,
  SUM(b.total_price) AS room_revenue
FROM Booking b
JOIN Guest g ON g.guest_id = b.guest_id
GROUP BY g.country;

-- REVENUE BY SEASON (LOW/MID/HIGH)
CREATE OR REPLACE VIEW v_revenue_by_season AS
SELECT
  b.season,
  COUNT(*)                          AS bookings,
  SUM(b.days_rented)                AS total_days,
  SUM(b.total_price)                AS room_revenue,
  ROUND(SUM(b.total_price) / NULLIF(SUM(b.days_rented),0), 2) AS avg_price_per_day
FROM Booking b
GROUP BY b.season;

-- DRINKS BY CATEGORY (fx donut: BAR vs COFFEE)
CREATE OR REPLACE VIEW v_drink_revenue_by_category AS
SELECT
  d.category,
  SUM(d.units_sold) AS units,
  SUM(d.total_sale) AS revenue
FROM DrinkSale d
GROUP BY d.category;

-- DRINKS AGGREGATED (top-liste pr. drink)
CREATE OR REPLACE VIEW v_drinks_aggregated AS
SELECT
  d.drink_name,
  d.category,
  SUM(d.units_sold) AS units,
  SUM(d.total_sale) AS revenue
FROM DrinkSale d
GROUP BY d.drink_name, d.category;

-- KPI TOTALS (samlet overblik til gateway)
CREATE OR REPLACE VIEW v_kpi_totals AS
SELECT
  (SELECT COALESCE(SUM(total_price),0) FROM Booking)   AS room_revenue,
  (SELECT COALESCE(SUM(total_sale),0)  FROM DrinkSale) AS drink_revenue,
  (SELECT COALESCE(SUM(total_price),0) FROM Booking)
+ (SELECT COALESCE(SUM(total_sale),0)  FROM DrinkSale) AS total_revenue;

